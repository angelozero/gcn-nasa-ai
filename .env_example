# GCN Nasa - https://gcn.nasa.gov
GCN_NASA_CLIENT_ID=
GCN_NASA_CLIENT_SECRET=
# 'gcn.notices.icecube.gold_bronze_track_alerts', 'gcn.notices.superk.sn_alert', 'gcn.notices.swift.bat.guano'
GCN_NASA_ALERTS='["gcn.circulars","gcn.notices.chime.frb","gcn.notices.dsa110.frb","gcn.notices.einstein_probe.wxt.alert","gcn.heartbeat","gcn.notices.icecube.lvk_nu_track_search","igwn.gwalert"]'

# LiteLLM Proxy (docker/docker-compose.yml)
OPENAI_API_KEY=
LITELLM_MASTER_KEY=sk-gcn-nasa-master-key

# LiteLLM Client (usado pelo src/app/llm/client.py)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-gcn-nasa-master-key
LLM_MODEL_CLASSIFIER=nasa-classifier
LLM_MODEL_EMBEDDER=nasa-embedder
LLM_MODEL_FAST=nasa-fast

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=terra
POSTGRES_DB=litellm
DATABASE_URL=postgresql://admin:terra@postgres:5432/litellm
